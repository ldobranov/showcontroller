[Unit]
Description=ShowController Video Node
After=multi-user.target

[Service]
ExecStart=/usr/bin/python3 /opt/showcontroller/modules/video_player/node.py
WorkingDirectory=/opt/showcontroller
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=5
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
